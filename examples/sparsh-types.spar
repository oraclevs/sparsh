export type SparshAlias {
    name: str;
    command: List<str>;
};

export type SparshEnvironmentVariable {
    name: str;
    value?: str;
    prepend?: List<str>;
    append?: List<str>;
};

export type SparshPromptPath {
    enabled?: bool;
    parentLength?: int;
    maxLastLength?: int;
    maxWidth?: int;
};

export type SparshPromptGit {
    enabled?: bool;
    showBranch?: bool;
    showAheadBehind?: bool;
    showStaged?: bool;
    showModified?: bool;
    showUntracked?: bool;
    showConflicts?: bool;
};

export type SparshPromptTime {
    enabled?: bool;
    format?: str;
};

export type SparshPromptSlot {
    text: str;
    color?: str;
    style?: List<str>;
};

export type SparshPromptThreshold {
    warn?: int;
    critical?: int;
};

export type SparshPromptThresholds {
    cpu?: SparshPromptThreshold;
    ram?: SparshPromptThreshold;
    disk?: SparshPromptThreshold;
    battery?: SparshPromptThreshold;
    load?: SparshPromptThreshold;
};

export type SparshPromptRight {
    slot1?: SparshPromptSlot;
    slot2?: SparshPromptSlot;
    slot3?: SparshPromptSlot;
    separator?: str;
    glyphWidth?: int;
    thresholds?: SparshPromptThresholds;
};

export type SparshPrompt {
    showStatus?: bool;
    showDuration?: bool;
    durationThresholdMs?: int;
    path?: SparshPromptPath;
    git?: SparshPromptGit;
    time?: SparshPromptTime;
    right?: SparshPromptRight;
};

export type SparshHistory {
    path?: str;
    maxEntries?: int;
    dedupeConsecutive?: bool;
};

export type SparshCompletion {
    enabled?: bool;
};

export type SparshKeybinding {
    key: str;
    action: str;
};

export type SparshPagerKeybinding {
    key: str;
    action: str;
};

export type SparshConfig {
    aliases?: List<SparshAlias>;
    environment?: List<SparshEnvironmentVariable>;
    prompt?: SparshPrompt;
    history?: SparshHistory;
    completion?: SparshCompletion;
    keybindings?: List<SparshKeybinding>;
    pagerKeybindings?: List<SparshPagerKeybinding>;
};
