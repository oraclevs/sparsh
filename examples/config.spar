// Copy as ~/.sparsh/sparsh.spar and place sparsh-types.spar beside it.
import type {
    SparshAlias,
    SparshEnvironmentVariable,
    SparshPrompt,
    SparshHistory,
    SparshCompletion,
    SparshKeybinding,
    SparshConfig
} from "./sparsh-types";

struct Config: SparshConfig {
    aliases = [
        { name: "gs"; command: ["git", "status"]; },
        { name: "ll"; command: ["eza", "-la", "--icons", "--git"]; }
    ];
    environment = [
        { name: "EDITOR"; value: "nvim"; },
        {
            name: "PATH";
            prepend: [
                "/opt/android-sdk/platform-tools",
                "$HOME/DevTools/flutter/bin",
                "$HOME/.cargo/bin",
                "$HOME/.local/bin"
            ];
            append: ["$HOME/.pub-cache/bin"];
        }
    ];
    prompt = {
        showStatus: true;
        path: { enabled: true; };
        git: { enabled: true; showBranch: true; showAheadBehind: true; };
        right: {
            // status (✕ code) is always first and is not configurable.
            slot1: { text: "{duration}"; color: "yellow"; };
            // Nerd Font glyphs are pasted straight into the text.
            slot2: { text: " {cpu}%   {ram}%"; color: "cyan"; };
            slot3: { text: " {date:%a %d %b}   {time:%I:%M %p}"; };
            separator: "  ";
            thresholds: {
                cpu: { warn: 70; critical: 90; };
                battery: { warn: 30; critical: 15; };
            };
        };
    };
    history = { maxEntries: 10000; dedupeConsecutive: true; };
    completion = { enabled: true; };
    keybindings: List<SparshKeybinding> = [
        // Defaults are retained unless the same chord is listed here.
        // Alt+Shift+Enter inserts a literal newline without submitting.
        // Bind `insertNewline` to another chord if your terminal cannot distinguish it.
        { key: "ctrl+r"; action: "historySearch"; },
        { key: "alt+e"; action: "openEditor"; }
    ];
};

function startup() -> shell {
    return shell {
        path append $(npm prefix -g)/bin;
        nitch;
    };
};
