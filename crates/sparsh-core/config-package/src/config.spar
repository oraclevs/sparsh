// Legacy compatibility copy of the public Sparsh config model.
// New configurations should keep these normal Spar types in
// ~/.sparsh/sparsh-types.spar rather than importing a native package.

export struct AliasConfig {
    name: str;
    command: List<str>;
};

export struct EnvironmentConfig {
    name: str;
    value: Option<str> = none();
    prepend: Option<List<str>> = none();
    append: Option<List<str>> = none();
};

export struct PromptPathConfig {
    enabled: Option<bool> = none();
    parentLength: Option<int> = none();
    maxLastLength: Option<int> = none();
    maxWidth: Option<int> = none();
};

export struct PromptGitConfig {
    enabled: Option<bool> = none();
    showBranch: Option<bool> = none();
    showAheadBehind: Option<bool> = none();
    showStaged: Option<bool> = none();
    showModified: Option<bool> = none();
    showUntracked: Option<bool> = none();
    showConflicts: Option<bool> = none();
};

export struct PromptTimeConfig {
    enabled: Option<bool> = none();
    format: Option<str> = none();
};

export struct PromptConfig {
    showStatus: Option<bool> = none();
    showDuration: Option<bool> = none();
    durationThresholdMs: Option<int> = none();
    path: Option<PromptPathConfig> = none();
    git: Option<PromptGitConfig> = none();
    time: Option<PromptTimeConfig> = none();
};

export struct HistoryConfig {
    path: Option<str> = none();
    maxEntries: Option<int> = none();
    dedupeConsecutive: Option<bool> = none();
};

export struct CompletionConfig {
    enabled: Option<bool> = none();
};

export struct KeybindingConfig {
    key: str;
    action: str;
};

export struct PagerKeybindingConfig {
    key: str;
    action: str;
};

export struct SparshConfig {
    aliases: Option<List<AliasConfig>> = none();
    environment: Option<List<EnvironmentConfig>> = none();
    prompt: Option<PromptConfig> = none();
    history: Option<HistoryConfig> = none();
    completion: Option<CompletionConfig> = none();
    keybindings: Option<List<KeybindingConfig>> = none();
    pagerKeybindings: Option<List<PagerKeybindingConfig>> = none();
};
